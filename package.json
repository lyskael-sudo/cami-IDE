{
  "name": "cami",
  "productName": "Cami",
  "desktopName": "cami",
  "version": "0.1.0",
  "description": "Cami — un IDE de bureau professionnel construit avec Electron, React et Monaco Editor.",
  "homepage": "https://cami.dev",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Cami",
    "email": "hello@cami.dev"
  },
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run typecheck && npm run test:gole",
    "test:gole": "npm --prefix gole test",
    "native:build": "cmake -S native/webkit-browser -B native/webkit-browser/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/webkit-browser/build --parallel",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.63.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "zustand": "^5.0.16"
  }
}
